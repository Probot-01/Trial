# NetraSetu PHC local backend (phc-local-app/backend) -- configuration template.
#
# Copy to phc-local-app/backend/.env (scripts/dev-up does this for you on first
# run) and fill in the blanks. .env is git-ignored; this file is committed and
# must never hold a real secret. Read by loadEnv.js: the real environment wins,
# then this service's .env, then the older shared <repo root>/.env.
#
# Every variable this service reads is listed. Commented-out lines show the
# built-in default and only need uncommenting to change it.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000

# ── Central link ─────────────────────────────────────────────────────────────
# Base URL of central-system/backend. No default: unset = nothing syncs, and
# the backend says so at startup (capture still works offline).
# (CENTRAL_URL is the old name and is still read, with a deprecation warning.)
CENTRAL_API_URL=http://localhost:5000
# This site's identity on central. scripts/seed-demo.js prints all three for
# each demo PHC; on a real site, `npm run provision-phc-key` on central does.
#   PHC_CODE     prefix of every patient/capture ID minted here
#                (docs/id-format-spec.md). Must be unique per PHC.
#   PHC_ID       phc_sites.phc_id (UUID) on central.
#   PHC_API_KEY  secret, sent as X-PHC-Api-Key on every sync.
PHC_CODE=PHC001
PHC_NAME=
PHC_ID=
PHC_API_KEY=
# 1 = never start the sync loop (tests, offline demos).
# SYNC_DISABLED=
# SYNC_INTERVAL_MS=10000
# SYNC_HEALTH_TIMEOUT_MS=3000
# SYNC_UPLOAD_TIMEOUT_MS=600000
# SYNC_CHUNK_THRESHOLD_BYTES=2097152
# SYNC_CHUNK_BYTES=1048576
# SYNC_CHUNK_TIMEOUT_MS=120000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Browser origins allowed to call this backend, comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Quality gate (MATLAB) ────────────────────────────────────────────────────
# Unset = `matlab` on PATH.
MATLAB_EXECUTABLE=
# MATLAB_TIMEOUT_MS=30000
# Compiled quality-gate executable, used instead of MATLAB when set.
# QUALITY_GATE_EXE=
# Unset (default) = a missing MATLAB fails the capture with 503
# quality_gate_failed (the image is saved). 1 = use the JS gate instead; only
# for a machine that has no MATLAB and no QUALITY_GATE_EXE.
# QUALITY_GATE_ALLOW_FALLBACK=

# ── Technician login (design doc §11.1) ──────────────────────────────────────
# Accounts: npm run technician -- add <username> "<Full Name>" [--admin]
#
# ON BY DEFAULT, and it should stay on. This backend binds 0.0.0.0 so the phone
# can reach it over the clinic LAN; with auth off, an anonymous GET /patients
# returns every registered patient's name, age and phone number to anything
# else on that network. It shipped as false because scripts/demo-reset.js
# needed it off to seed -- that script now logs in as the technician account it
# creates, so the reason is gone.
#
# Turning it off is a deliberate choice for an isolated machine, not a default:
# create an account first, or the app has no way in.
LOCAL_AUTH_ENABLED=true
# LOCAL_SESSION_HOURS=12
# HTTPS for this backend (TLS 1.2+); both set = HTTPS only.
# LOCAL_TLS_KEY_PATH=
# LOCAL_TLS_CERT_PATH=

# ── Storage ──────────────────────────────────────────────────────────────────
# LOCAL_DB_PATH=./db/local.sqlite
# LOCAL_STORAGE_DIR=./storage

# ── Desktop <-> phone sync (docs/peer-sync-protocol.md) ──────────────────────
# How long a paired device may be silent before the other uploads its queued
# captures to central instead.
# PEER_TAKEOVER_MS=21600000
