{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "netrasetu/*"
      ]
    }
  },
  "include": [
    "netrasetu/**/*.ts",
    "netrasetu/**/*.tsx",
    "App.tsx"
  ],
  "exclude": [
    "node_modules",
    "src"
  ]
}
