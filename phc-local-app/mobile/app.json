{
  "expo": {
    "name": "NetraSetu PHC",
    "slug": "netrasetu-phc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF6EF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.netrasetu.phc"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF6EF"
      },
      "package": "com.netrasetu.phc",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "NetraSetu uses the camera with an attached fundus lens to photograph the retina.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NetraSetu imports retinal images taken on the PHC's fundus camera from your photo library."
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-asset",
      "expo-sharing",
      "expo-splash-screen",
      "expo-secure-store"
    ],
    "owner": "tanujb03",
    "extra": {
      "eas": {
        "projectId": "67368179-6d0a-494e-8850-31c7d7d47b89"
      }
    }
  }
}
