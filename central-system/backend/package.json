{
  "name": "dr-screening-central-backend",
  "version": "1.0.0",
  "description": "Central grading server for DR screening system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "setup-db": "node ../../scripts/setupCentralDb.js",
    "migrate": "node ../../scripts/setupCentralDb.js",
    "migrate:down": "node ../../scripts/setupCentralDb.js --down",
    "migrate:create": "node-pg-migrate create -m db/migrations -j sql --migration-filename-format index",
    "seed-users": "node ../../scripts/seedDemoUsers.js",
    "provision-phc-key": "node ../../scripts/provisionPhcKey.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.11.0",
    "twilio": "^6.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
