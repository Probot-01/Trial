# NetraSetu central backend (central-system/backend) -- configuration template.
#
# Copy to central-system/backend/.env (scripts/dev-up does this for you on first
# run) and fill in the blanks. .env is git-ignored; this file is committed and
# must never hold a real secret. Read by loadEnv.js: the real environment wins,
# then this service's .env, then the older shared <repo root>/.env.
#
# Every variable this service reads is listed. Commented-out lines show the
# built-in default and only need uncommenting to change it.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
# production hides internal error messages from 500 responses.
NODE_ENV=development

# ── Postgres ─────────────────────────────────────────────────────────────────
# docker-compose.dev.yml publishes Postgres on host port 5433 (not 5432, so it
# never collides with a Postgres already installed on the machine).
DATABASE_URL=postgresql://netrasetu:netrasetu_dev@localhost:5433/dr_screening_central
# Alternative to DATABASE_URL (used only when DATABASE_URL is unset):
# PGHOST=localhost
# PGPORT=5433
# PGDATABASE=dr_screening_central
# PGUSER=netrasetu
# PGPASSWORD=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Browser origins allowed to call this API, comma-separated. Credentials are on
# (session cookie), so '*' is refused at startup. Unset = the two local dev
# frontends only (http://localhost:5173 and :5174). A hosted frontend must be
# listed, e.g. https://netrasetu.vercel.app or the pattern https://*.vercel.app.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Auth (backend plan §A) ───────────────────────────────────────────────────
# Enforce browser logins for ophthalmologist / district_admin routes. The
# central frontend has a real login page, so this is on for local dev too.
# (Code default when unset: off.)
AUTH_ENABLED=true
# Required when AUTH_ENABLED=true (>= 32 chars). scripts/dev-up fills it in on
# first run; otherwise generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Session length in hours, (0, 24]. No refresh tokens.
# JWT_TTL_HOURS=12
# lax for a same-site frontend (the default, and what the Vite proxy gives
# you); none only when the frontend is on another site, which forces Secure.
# COOKIE_SAMESITE=lax
# Secure flag on the session cookie. false ONLY for local plain-HTTP dev; in
# any deployment leave it unset (default true) behind TLS.
COOKIE_SECURE=false
# Which proxy hops to trust for X-Forwarded-For/-Proto (Express "trust proxy").
# Default loopback (the Vite dev proxy, or nginx on the same host). Behind a
# platform load balancer set e.g. TRUST_PROXY=1.
# TRUST_PROXY=loopback
# Minutes a reviewer's claim on a case holds before someone else may take it.
# CLAIM_TTL_MINUTES=30
# Require X-PHC-Api-Key on PHC ingestion routes. Keys come from scripts/seed-demo.js
# (local dev, written into the PHC backend's .env) or `npm run provision-phc-key`.
PHC_AUTH_ENABLED=true

# MEDIA_ROOT= (optional) directory for case media; default backend/media. The e2e run sets a scratch one.

# ── Encryption at rest for case media (docs/SECURITY.md) ────────────────────
# AES-256-GCM key for stored images, Grad-CAM overlays, masks and report PDFs:
# 32 bytes as 64 hex chars. scripts/dev-up fills it in on first run; otherwise:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Unset = new media is stored in plaintext (the backend says so at boot).
# LOSING THIS KEY MAKES EVERY ENCRYPTED FILE UNREADABLE. Existing plaintext
# media: node scripts/encryptMedia.js
MEDIA_ENCRYPTION_KEY=

# ── TLS (§A.14) ──────────────────────────────────────────────────────────────
# Both set = HTTPS only. `node scripts/generateDevCert.js` makes a self-signed pair.
# TLS_KEY_PATH=
# TLS_CERT_PATH=

# ── Demo accounts (scripts/seed-demo.js, scripts/seedDemoUsers.js) ───────────
# Passwords for the two seeded users. Unset = a random password is generated
# and printed once by seed-demo.js.
DEMO_OPHTHALMOLOGIST_PASSWORD=
DEMO_ADMIN_PASSWORD=

# ── Inference engines ────────────────────────────────────────────────────────
# Forward slashes deliberately: Windows accepts them, and they survive .env
# parsers and MATLAB string literals. Unset = `matlab` on PATH.
MATLAB_EXECUTABLE=
# Branch A classifier: matlab (default) | python | remote
# 'remote' also redirects segmentation (see gradingOrchestrator.js's segment())
# -- it's the SIH online-demo deployment only, where the host has no local
# Python/PyTorch install at all and both run on ml-inference-service instead
# (a separate HTTP service, deployed on Hugging Face Spaces). Requires
# ML_INFERENCE_SERVICE_URL. Not used on a machine that has MATLAB or a local
# Python ML env -- leave this unset there.
# INFERENCE_BACKEND=matlab
# Base URL of the deployed ml-inference-service (e.g. an HF Space URL).
# Required only when INFERENCE_BACKEND=remote.
# ML_INFERENCE_SERVICE_URL=
# ML_INFERENCE_TIMEOUT_MS=180000
# Lesion segmentation (LOCAL python backend only -- read by segInfer.py
# itself, not by gradingOrchestrator.js): matlab (default) | python
# SEG_INFERENCE_BACKEND=matlab
# Unset (default) = a MATLAB-session failure during segmentation fails the case
# (retried, then 'error'). 1 = re-run those models on PyTorch instead; the case
# still records it (engineProvenance.segmentation.*.fallback = true).
# SEG_ALLOW_PYTHON_FALLBACK=
# Python for the ML pipeline and the segmentation worker: the conda env with
# ml-pipeline/requirements.txt, e.g. C:/Users/you/miniconda3/envs/dr_screening/python.exe
# Unset = `python` on PATH.
PYTHON_EXECUTABLE=
# One-shot `matlab -batch` timeout.
# MATLAB_TIMEOUT_MS=120000
# Unset (default) = a missing MATLAB fails the case loudly. 1 = substitute the
# JS re-implementation for the MATLAB-only stages; only for a machine that has
# no MATLAB at all.
# MATLAB_ALLOW_FALLBACK=
# Persistent MATLAB session (ml-pipeline/inference/matlabSession).
# MATLAB_SESSION_DIR=
# MATLAB_SESSION_TIMEOUT_MS=30000
# MATLAB_CASE_PIPELINE_TIMEOUT_MS=120000
# MATLAB_HEARTBEAT_PATH=
# Python segmentation worker session.
# SEG_SESSION_DIR=
# SEG_SESSION_TIMEOUT_MS=120000
# SEG_HEARTBEAT_PATH=

# ── Grading queue (in-process; no Redis) ─────────────────────────────────────
# GRADING_CONCURRENCY=1
# GRADING_MAX_ATTEMPTS=3
# GRADING_RETRY_BASE_MS=2000

# ── Reliability (backend plan §D-§F) ─────────────────────────────────────────
# GRADING_WATCHDOG_INTERVAL_MS=90000
# WATCHDOG_MIN_AGE_SECONDS=120
# WATCHDOG_MAX_RECOVERIES=3
# MATLAB session supervisor: on whenever a MATLAB engine is selected. It also
# STARTS the session when this backend boots.
# MATLAB_SUPERVISOR_ENABLED=true
# MATLAB_SUPERVISOR_INTERVAL_MS=30000
# MATLAB_HEARTBEAT_STALE_MS=30000
# MATLAB_STARTUP_GRACE_MS=240000
# MATLAB_MAX_RESTARTS=3
# MATLAB_RESTART_WINDOW_MS=1800000
# SEG_WORKER_SUPERVISOR_ENABLED=true
# SEG_SUPERVISOR_INTERVAL_MS=30000
# SEG_HEARTBEAT_STALE_MS=30000
# SEG_STARTUP_GRACE_MS=90000
# SEG_MAX_RESTARTS=3
# SEG_RESTART_WINDOW_MS=1800000
# GET /health component probes: the DB check's cap, and how often the (cached,
# background) Python probe is refreshed / how long it may take.
# HEALTH_DB_TIMEOUT_MS=1000
# HEALTH_PYTHON_PROBE_INTERVAL_MS=60000
# HEALTH_PYTHON_PROBE_TIMEOUT_MS=60000
# System Health thresholds (§F).
# A PHC is "silent" when it has made no contact of any kind within this many hours.
# ONE definition, used by both GET /admin/system-health and GET /admin/phcs
# (services/phcSilence.js). Replaces the old SILENT_PHC_HOURS (48), which is ignored.
# PHC_SILENT_HOURS=24
# STUCK_JOB_MINUTES=15
# UNREVIEWED_CASE_HOURS=48

# ── Chunked upload (Task 8.2) ────────────────────────────────────────────────
# UPLOAD_MAX_CHUNK_BYTES=4194304
# UPLOAD_MAX_TOTAL_BYTES=67108864
# UPLOAD_MAX_CHUNKS=2048
# UPLOAD_SESSION_TTL_MS=604800000

# ── District resource model and Simulink validation (§G) ─────────────────────
# REPORT_TIMEZONE=Asia/Kolkata
# RESOURCE_MODEL_CRON=30 2 * * *
# RESOURCE_MODEL_TIMEOUT_MS=600000
# RESOURCE_MODEL_ANNUAL_PATIENTS=
# SIMULINK_VALIDATION_ENABLED=true
# SIMULINK_VALIDATION_CRON=0 3 * * 0
# SIMULINK_VALIDATION_TIMEOUT_MS=1200000
# SIMULINK_VALIDATION_PATH=

# ── Retraining trigger ───────────────────────────────────────────────────────
# RETRAIN_THRESHOLD=20
# RETRAIN_SCHEDULE=

# ── SMS (Twilio) ─────────────────────────────────────────────────────────────
# 1 = log messages instead of sending them (recommended for local dev).
# Unset/0 = send when the Twilio credentials below are set; with none set,
# sending fails and the referral moves to manual follow-up (design doc §10.5).
SMS_DRY_RUN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Public https URL of POST /api/v1/notifications/sms-status; must match exactly
# (Twilio signs it). Unset = only immediate send failures are caught.
# TWILIO_STATUS_CALLBACK_URL=
REFERRAL_CLINIC_NAME=
