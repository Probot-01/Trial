# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
.pnp
.pnp.js

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production

# ── SQLite (local PHC database — runtime artefact, never commit) ──────────────
*.sqlite
*.sqlite3
*.db
# WAL sidecars (localDb.js sets journal_mode = WAL); *.sqlite does not match these
*.sqlite-wal
*.sqlite-shm

# ── Patient-derived imagery — NEVER commit any of this ────────────────────────
# Captures written by the PHC app, and the central server's media tree plus
# Grad-CAM overlays. All of it is derived from patient fundus photographs and
# falls under the same handling rule as the raw captures.
phc-local-app/backend/uploads/
phc-local-app/backend/captures/
phc-local-app/backend/storage/
central-system/backend/media/
central-system/backend/explainability-outputs/
# Pre-encryption plaintext media moved out of the served tree (2026-09-26).
# Never served, never committed.
central-system/backend/media-archive/
media-archive/

# ── Dataset images ────────────────────────────────────────────────────────────
# datasets/.gitignore already handles this with */
# but belt-and-suspenders at the root level:
datasets/aptos2019/
datasets/idrid/
datasets/drive/
datasets/messidor2/

# ── MATLAB artefacts ──────────────────────────────────────────────────────────
# Autosave backups created by the MATLAB editor
*.asv
*.m~

# Trained network / model weight files (can be hundreds of MB)
# Store these in a shared drive or object storage, not git.
# ** so nested model folders (models/Model1/, models/Model4/, ...) are covered too.
central-system/backend/ml-pipeline/models/**/*.mat
central-system/backend/ml-pipeline/models/**/*.onnx
central-system/backend/ml-pipeline/models/**/*.pt
central-system/backend/ml-pipeline/models/**/*.pth
central-system/backend/ml-pipeline/models/**/*.ckpt
central-system/backend/ml-pipeline/models/**/*.h5
# Keep the README that documents where models live
!central-system/backend/ml-pipeline/models/README.md
# Exported ONNX for a model version still in progress -- large, not deployment
# ready yet, ships via the netrasetu_handoff drop like the other v2 binaries.
central-system/backend/ml-pipeline/training/onnx_out/red_lesion_unet_v2.onnx

# MATLAB Compiler standalone executable output (Task 8.1)
*.exe
*.app
*.ctf
requiredMCRProducts.txt

# ── Simulink ─────────────────────────────────────────────────────────────────
# Build cache and derived files. The .slx itself IS committed — it is the
# Task 3.8 deliverable — but it is rebuilt by buildDistrictScreeningModel.m,
# which is the reviewable source of truth for it.
simulink-model/slprj/
*.slxc
# Regenerated on every run of referenceQueueingModel.m
simulink-model/simulation-results.csv

# ── Test scaffolding ─────────────────────────────────────────────────────────
# Written by scripts/seedTestCase.js. Points at a case_id that exists in exactly
# one local database, so it is meaningless to anyone else.
test_case_id.txt

# ── Python (bridge scripts, preprocessing helpers) ────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log

# ── OS artefacts ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
ehthumbs.db

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Build / dist ──────────────────────────────────────────────────────────────
dist/
build/
.next/
out/

# Exception to the generic "out/" rule above: diagnostics/out/ holds
# evaluation/parity/calibration reports (json, txt, csv, npy, png) that are
# committed as evidence. This used to be a hand-maintained per-file allowlist
# (!path for each report), which silently dropped every new versioned report
# (v2b, v2c, ...) that wasn't added to the list by hand. Un-ignoring the whole
# directory instead removes that maintenance trap; nothing in practice was
# ever meant to be excluded from it.
!central-system/backend/ml-pipeline/diagnostics/out/

# Task verification scripts — developer tooling, run locally, not part of the
# deliverable. Kept on disk (and in git history up to 95222e9) so each task can
# still be re-verified; simply not carried in the repo.
verify_task*.js

# MATLAB Compiler build output (Task 8.1). Rebuildable with
# buildQualityGateExe.m; a 1.4 MB binary plus generated logs does not belong
# in the repo, and the .cmd wrapper is machine-specific (it hardcodes the
# local MATLAB Runtime path).
phc-local-app/backend/quality-gate-matlab/dist/

# Traced copy of Branch A for MATLAB import (Task: PyTorch converter test).
# Rebuildable in seconds with traceModel1ForMatlab.py, and a 16 MB binary that
# duplicates weights already tracked in branchA_v1.pt.
central-system/backend/ml-pipeline/models/Model1/branchA_v1_traced.pt

# Model1 prediction CSVs — a bridge from the shipped .npy files into MATLAB,
# regenerated in seconds by exportModel1Predictions.py. The .npy originals are
# the source of truth and are tracked.
central-system/backend/ml-pipeline/models/Model1/*.csv

# PyTorch->MATLAB import experiment artifacts (traced models, probe tensors).
# All regenerable; the traced .pt files duplicate weights already tracked.
central-system/backend/ml-pipeline/models/Model1/*_traced*.pt
central-system/backend/ml-pipeline/models/Model1/probe_*.csv

# MATLAB namespace package emitted by importNetworkFromPyTorch for custom
# layers. A by-product of the (failed) import experiment, regenerated by
# testImportedNetwork.m, and not used by anything that runs.
central-system/backend/ml-pipeline/+branchA_v1_traced*/

# Persistent-worker runtime state. A heartbeat, a PID and a queue of in-flight
# requests describe THIS machine at THIS moment: committed, they are noise in
# every diff, and a checked-out session.pid from someone else's machine names a
# process that is either gone or, worse, something unrelated that has been
# given the same number since.
central-system/backend/ml-pipeline/inference/matlabSession/session.heartbeat
central-system/backend/ml-pipeline/inference/matlabSession/session.pid
central-system/backend/ml-pipeline/inference/matlabSession/stop.flag
central-system/backend/ml-pipeline/inference/matlabSession/requests/
central-system/backend/ml-pipeline/inference/matlabSession/responses/
central-system/backend/ml-pipeline/inference/segSession/worker.heartbeat
central-system/backend/ml-pipeline/inference/segSession/worker.pid
central-system/backend/ml-pipeline/inference/segSession/stop.flag
central-system/backend/ml-pipeline/inference/segSession/requests/
central-system/backend/ml-pipeline/inference/segSession/responses/

# The weekly SimEvents validation's result: one current fact about THIS
# machine's last run, not history worth versioning.
simulink-model/out/

# Self-signed dev TLS pair (scripts/generateDevCert.js) -- never commit keys
certs/

# Model binaries delivered into training/ (copied to models/, already ignored).
# ~340 MB; never commit. parity_data/*.mat is a subdirectory and unaffected.
central-system/backend/ml-pipeline/training/*.mat

# Exported training corpora (scripts/exportTrainingSet.js). Patient fundus
# images plus their labels -- the same handling rule as media/, and the one
# directory in this repo whose whole purpose is to collect them in one place.
exports/

# Compiled MATLAB Compiler output (exe + CTF, ~250 MB). The SOURCE lives in
# deploy/*.m; rebuild with deploy/buildCaseChain.m.
central-system/backend/ml-pipeline/deploy/dist/

# One-off dumps from code-survey tooling, not part of the project.
all_code.txt
extract_info.js
extract_info.txt
tree.txt

# Generated by the ml-pipeline diagnostics and preprocessing smoke tests.
# UNTRACKED, NOT DELETED: these are regenerated output, and the experiments
# that produce them stay in the repo (training/diag*.py) because older
# approaches are kept, not removed. They showed up dirty on every run.
central-system/backend/ml-pipeline/test_output_*.png
central-system/backend/ml-pipeline/training/diag*_out.txt
central-system/backend/ml-pipeline/training/diag*_err.txt
